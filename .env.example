# Frontend (Vercel / Vite) — set this in Vercel Project Settings → Environment Variables
# Example: https://sam-loc-api.onrender.com
VITE_SOCKET_URL=

# Backend (Render / Railway / Fly) — optional; restrict browser origins
# Comma-separated list, e.g. https://sam-loc.vercel.app,http://localhost:5173
CORS_ORIGIN=*
PORT=3001
